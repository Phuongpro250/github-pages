<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Game Tài Xỉu</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="container">
    <h1>Game Tài Xỉu</h1>
    <p>Chọn cược của bạn:</p>
    <button onclick="play('Tài')">Tài</button>
    <button onclick="play('Xỉu')">Xỉu</button>
    <div id="result"></div>
  </div>
  <script src="script.js"></script>
</body>
</html>
body {
  font-family: Arial, sans-serif;
  background: #f5f5f5;
  text-align: center;
  padding-top: 50px;
}

.container {
  background: white;
  padding: 30px;
  border-radius: 10px;
  width: 300px;
  margin: auto;
  box-shadow: 0 0 10px rgba(0,0,0,0.1);
}

button {
  padding: 10px 20px;
  margin: 10px;
  font-size: 18px;
  cursor: pointer;
}

#result {
  margin-top: 20px;
  font-size: 20px;
}
function rollDice() {
  return [
    Math.floor(Math.random() * 6) + 1,
    Math.floor(Math.random() * 6) + 1,
    Math.floor(Math.random() * 6) + 1
  ];
}

function play(choice) {
  const dice = rollDice();
  const total = dice.reduce((a, b) => a + b, 0);
  const result = (total >= 11 && total <= 17) ? 'Tài' : 'Xỉu';

  const isTriple = dice[0] === dice[1] && dice[1] === dice[2];

  let message = `Xúc xắc: ${dice.join(', ')} (Tổng: ${total})<br>`;
  if (isTriple) {
    message += 'Ba số giống nhau - Nhà cái thắng!';
  } else if (choice === result) {
    message += `Bạn chọn ${choice} => Bạn thắng!`;
  } else {
    message += `Bạn chọn ${choice} => Bạn thua!`;
  }

  document.getElementById('result').innerHTML = message;
}
